<?xml version="1.0" encoding="utf-8"?>
<!--
    AlgoKing adaptive-icon background — the navy tile, full bleed.

    A vector rather than a bitmap on purpose: the tile is nothing but smooth
    gradients, so a vector is a fraction of the size and cannot band.

    Geometry is tuned for the MASKED view, not the whole 108dp canvas. Only the
    central 72dp survives the launcher mask, so the radial lift and the gold
    bounce sit where they will actually be seen rather than where they sit in
    the 1024px artwork (docs/brand/algoking-icon-01-sovereign.svg).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground: navy at the top-left falling to near-black at the foot. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10.8"
                android:startY="0"
                android:endX="75.6"
                android:endY="108">
                <item android:offset="0" android:color="#FF141F42" />
                <item android:offset="0.5" android:color="#FF0A1128" />
                <item android:offset="1" android:color="#FF04070D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lift: the glow the mark stands in front of. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="34.5"
                android:gradientRadius="81">
                <item android:offset="0" android:color="#B322376F" />
                <item android:offset="0.5" android:color="#4D101B3C" />
                <item android:offset="1" android:color="#0004070D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bounce: warm light off the floor, under the climb. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="88"
                android:gradientRadius="30">
                <item android:offset="0" android:color="#3DF0BB44" />
                <item android:offset="1" android:color="#00F0BB44" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Scrim: deepens the ground directly behind the letters so the silver
         edge of the A keeps its contrast against the lift. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="38">
                <item android:offset="0" android:color="#9E03060C" />
                <item android:offset="0.62" android:color="#5703060C" />
                <item android:offset="1" android:color="#0003060C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
